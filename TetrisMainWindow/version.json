{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "1.1-beta",
  "publicReleaseRefSpec": [
    "^refs/heads/main$"
  ],
  "releasebranch": {
    "pattern": "release",
    "versionIncrement": "patch",
    "preRelease": ""
  },
  "nonPublicReleaseRefSpec": [
    "^refs/heads/feature/.*",
    "^refs/heads/bug/.*"
  ],
  "assemblyVersion": {
    "precision": "build"
  },
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  }
}
